# 이 파일을 복사해 src/.env 로 저장한 뒤 값을 채운다.
#   Windows : copy src\.env.example src\.env
#   Linux   : cp src/.env.example src/.env
# src/.env 는 형상관리·배포 압축본에 넣지 않는다. (API 키가 들어 있다)

# ── 필수 ─────────────────────────────────────────────────────────────
# SSAFY GMS API 키 (https://gms.ssafy.io/web/)
GMS_KEY=

# ── 강력 권장 ────────────────────────────────────────────────────────
# 벡터 색인 저장 위치. 반드시 영문(ASCII) 경로로 지정한다.
# chromadb는 한글 등이 섞인 경로에 벡터 파일을 쓰지 못한다. 오류 없이 색인이 끝나지만
# 검색이 실패하고 답변이 "문서로 확인 불가"로 나온다.
# 비워 두면 프로젝트의 resources/indexes 를 쓴다. (프로젝트 경로가 영문일 때만 안전)
#   Windows 예) INDEX_DIR=C:\movielab_indexes
#   Linux   예) INDEX_DIR=/srv/movielab/indexes
INDEX_DIR=C:/movielab_indexes

# 답변·추천·관람 가이드 모델. 작은 모델은 사실 판정을 "문서로 확인 불가"로 자주 미룬다.
# (README "모델과 답변 품질" 참고) 비워 두면 gpt-5.4-nano.
CHAT_MODEL=gpt-5.4

# 위키백과·위키데이터 요청 연락처. 비워 두면 분당 10회로 제한된다. (채우면 분당 200회)
# 사전 구축 코퍼스를 쓰면 거의 호출하지 않지만, 새 질문 키워드로 추가 수집하거나
# 위키데이터 원문이 없는 영화를 처음 물을 때 쓰인다.
#   예) WIKI_CONTACT=https://github.com/<계정>/movie-lab; <계정>@example.com
WIKI_CONTACT=

# ── 선택 ─────────────────────────────────────────────────────────────
# 영화 목록을 TMDB에서 다시 수집할 때만 필요하다.
TMDB_KEY=

# 키워드 추출·문서 선별 모델 (기본 gpt-5.4-nano)
# KEYWORD_MODEL=gpt-5.4-nano
# SELECT_MODEL=gpt-5.4-nano

# 임베딩 모델. 바꾸면 색인을 전부 다시 만들어야 한다. (기본 text-embedding-3-small)
# EMBEDDING_MODEL=text-embedding-3-small

# 검색 설정 (기본값)
# TOP_K_WIKI=10
# USE_MMR=1
# FETCH_K=30
