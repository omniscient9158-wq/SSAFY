# GMS API key. Add your own key to the local .env file.
GMS_KEY=

# Wikimedia API contact: operator email, project website URL, or Wikimedia username.
WIKIMEDIA_CONTACT=

# Optional settings
INDEX_DIR=./indexes
CHAT_MODEL=gpt-5.4-nano
EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=6
EMBEDDING_BATCH_SIZE=100
